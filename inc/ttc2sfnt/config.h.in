#pragma once

/*!
 * \file config.h
 * \brief Compile time configuration of the library, generated by CMake.
 *
 * This file is not part of the source tree: `CMakeLists.txt` configures
 * `inc/ttc2sfnt/config.h.in` into `<build>/generated/ttc2sfnt/config.h`, and both the sources and
 * every consumer include that copy, so the build directory has to be on the include path in front
 * of `inc`.
 *
 * The file carries the build mode only - the version of the library is maintained by hand in
 * `inc/ttc2sfnt/ttc2sfnt.h` and is not touched by the build system.
 *
 * `TTC2SFNT_HEAD_ONLY` mirrors the `TTC2SFNT_HEAD_ONLY` CMake option:
 *  - `ON` (default): every function is declared `inline` through `TTC2SFNT_HEAD_ONLY_INLINE` and the
 *    headers include the `.cpp` files themselves; the library is an INTERFACE target and `src` has
 *    to stay on the include path;
 *  - `OFF`: the files of `src` are compiled into a static library, and only `inc` is needed.
 *
 * Without CMake, copy this file to `inc/ttc2sfnt/config.h` and replace the `#cmakedefine` line by
 * `#define TTC2SFNT_HEAD_ONLY` for the header only build, or leave it out for the compiled one.
 */

/*!
 * The library uses the C `stdio` functions on purpose: it has no dependencies, and `FILE*` is the
 * one file API every C++11 implementation has. MSVC marks those functions as deprecated with C4996,
 * which would otherwise drown every translation unit of this dependency free library in warnings.
 */
#if defined(_MSC_VER) && !defined(_CRT_SECURE_NO_WARNINGS)
#define _CRT_SECURE_NO_WARNINGS
#endif

#cmakedefine TTC2SFNT_HEAD_ONLY

#ifdef TTC2SFNT_HEAD_ONLY
#define TTC2SFNT_HEAD_ONLY_INLINE inline //!< Functions stay `inline` in header only mode.
#else
#define TTC2SFNT_HEAD_ONLY_INLINE        //!< Nothing to add when the sources are compiled directly.
#endif // TTC2SFNT_HEAD_ONLY
