*.ipdb

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
generated/

# The configured ttc2sfnt_config.h lives in the build directory; this one only appears when
# somebody copied ttc2sfnt_config.h.in by hand to build without CMake, and must not be committed.
inc/ttc2sfnt/ttc2sfnt_config.h

# IDE noise
.vs/
.vscode/
*.user
*.suo

# Test scratch directory (created and removed by test/test_ttc.cpp)
ttc2sfnt_test_tmp/

# Fonts are not part of the repository: .ttc files are usually vendor fonts.
# Drop one in fonts/ to let the tests use it; it stays untracked.
fonts/*.ttc
fonts/*.ttf
fonts/*.otf
